  "goal": "Convert the RC6 metadata-only, verification-blocked payload channel into signed payload consumption and controlled execution evidence while keeping the mirror, signer, installer, AgentCore, SecurityExecutionEngine, fleet, and TUI authority boundaries explicit.",
  "core_thesis": "AIOS becomes Ubuntu-like only when users can fetch public metadata from the mirror, verify signed and revocation-bound payload metadata locally, and move into canary or rollback execution only through exact approvals, AgentCore PlanSpec, and SecurityExecutionEngine.",
  "non_goals": [
    "Do not claim GA production readiness.",
    "Do not read, copy, print, hash, or move private signing material.",
    "Do not let the mirror host sign payloads or become the root of trust.",
    "Do not install, activate, rollback, mutate active slots, mutate production rings, upload support bundles, or enable remote fleet dispatch from contract work.",
    "Do not treat signature reachability as sufficient without revocation, freshness, installer compatibility, rollback baseline, TLS, and controlled execution evidence."
  ],
  "primary_acceptance": [
    "The signed payload consumption contract defines trust inputs, endpoint extensions, signer boundary, installer states, fail-closed cases, and authority boundaries.",
    "Signed metadata and revocation snapshot publication are planned as public artifacts only; private key operations remain outside the repo and mirror.",
    "Installer consumption remains blocked until signature, revocation, compatibility, rollback baseline, freshness, and hash bindings all verify.",
    "Controlled execution remains exact-approval gated through AgentCore PlanSpec and SecurityExecutionEngine, with no direct authority granted to mirror, frontend, signer, TUI, shell, or model replay.",
    "RC7 keeps production_ready_claim=false until final audit proves all GA gates."
  ],
